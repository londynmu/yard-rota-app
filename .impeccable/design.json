  "narrative": {
    "northStar": "Yard Control Desk",
    "overview": "Yard Rota’s visual system is an operational control desk for a UK logistics yard: calm slate surfaces, frosted content cards, and a single clear blue signal for primary actions and “today / selected” states. Density stays readable on a phone in the yard and on a desktop in the office. Personality lives in soft glass cards, gentle gradient headers, and status colour — not in decorative illustration or loud marketing chrome.\n\nWeb (`src/`) is a light-only Operate UI built with React, Vite, and Tailwind. Flutter shares the same slate/blue primitive family via `app_tokens.dart`, with tinted AppCard shells on Info / Breaks / Calendar. Adaptive means one product language, expressed through each client’s tokens.\n\nConfirmed visual anti-references: dark-theme-first product chrome; purple-to-indigo “AI” gradients; overloaded glassmorphism; and heavy enterprise dashboards.",
    "keyCharacteristics": [
      "Control Surface Slate page washes with Shift Blue as the rare, decisive accent",
      "Frosted card-modern / glass bars as the default content shell",
      "Hybrid depth: soft shadows plus tinted borders / washes",
      "Segmented filters and equal columns for location + shift",
      "English UI copy; system/UI type stacks (no decorative display face)"
    ],
    "rules": [
      { "name": "The One Signal Rule", "body": "Shift Blue is for primary action, selection, and “today” — not for large fills across an entire screen. Status greens/ambers/reds stay on badges and alerts.", "section": "colors" },
      { "name": "The Light Desk Rule (web)", "body": "Web ships light-only (color-scheme: light). Do not introduce a product dark theme on web without an explicit redesign decision.", "section": "colors" },
      { "name": "The Reuse Palette Rule", "body": "Extend tailwind.config.js / app_tokens.dart; do not invent local hex in feature widgets.", "section": "colors" },
      { "name": "The No Display Face Rule", "body": "Do not introduce Inter-as-brand, serif heroes, or marketing type pairings. Stay on system UI type unless the owner explicitly rebrands.", "section": "typography" },
      { "name": "The Four-Column Filter Rule", "body": "Location + three shifts stay equal-width; never let one label steal the row.", "section": "layout" },
      { "name": "The Hybrid Desk Rule", "body": "Depth = light shadow and border/wash. Do not rely on drop shadow alone, and do not stack multi-layer neon glows.", "section": "elevation" },
      { "name": "The Card Shell Rule", "body": "New content sections copy card-modern (web) or tinted AppCard (Flutter) — do not invent a third shell language.", "section": "shapes" }
    ],
    "dos": [
      "Do reuse Info / Breaks / Calendar / Shunter of the Month card patterns and shared classes (card-modern, page-content-inner, filter-bar-segmented, Flutter AppCard / tokens).",
      "Do keep user-facing copy in English.",
      "Do put new colours and radii into tailwind.config.js or app_tokens.dart before using them in features.",
      "Do keep Shift Blue scarce and purposeful (The One Signal Rule).",
      "Do preserve hybrid depth: soft shadow + slate/blue wash borders."
    ],
    "donts": [
      "Don't change business or domain logic while restyling.",
      "Don't invent purple-indigo AI gradients, dark-first web chrome, or heavy enterprise table walls.",
      "Don't invent a new card/button language when an existing shell fits.",
      "Don't ship Inter/serif display branding or emoji-led decoration as system identity.",
      "Don't hard-code one-off hex/spacing in feature widgets when a token already exists."
    ]
  }
}
