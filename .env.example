# All three variables are required. The production/preview build fails without them.
# Copy to .env.local for local dev. Do not commit real keys.

# DHL Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Publishable key (sb_publishable_…) or legacy anon JWT
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

# Public site URL for auth redirects, canonical, and OG tags (no trailing slash)
VITE_SITE_URL=https://dhl.shunters.net
