# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL for production redirects
VITE_SITE_URL=https://shunters.net

# Error monitoring (optional). Sentry is only loaded when VITE_SENTRY_DSN is set.
VITE_SENTRY_DSN=
# Source map upload during build (set in Netlify environment variables, never commit real values)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
